# ─────────────────────────────────────────────────────────────
# Alora — environment contract. Copy to `.env.local` and fill in.
# Never commit real values; only this template is tracked.
# ─────────────────────────────────────────────────────────────

# --- Core (required) ---
# Server-side session secret. Generate: `openssl rand -base64 32`
BETTER_AUTH_SECRET=
# Canonical server URL better-auth signs/verifies against. Use https in prod.
BETTER_AUTH_URL=http://localhost:3000
# Postgres connection string (Neon). Must be reachable at build+runtime.
DATABASE_URL=

# --- Public (exposed to the browser — never put secrets here) ---
# Client-visible base URL; used by auth-client, metadata, robots, sitemap.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_BETTER_AUTH_URL=http://localhost:3000

# --- Transactional email (required for verification + password reset) ---
# Without RESEND_API_KEY, verification/reset links are only logged, not sent.
RESEND_API_KEY=
# Sender address. For real delivery to customers this MUST be on a domain you've
# verified in Resend (SPF/DKIM/DMARC). The resend.dev sandbox sender only
# delivers to your own Resend account address. Example: 'Alora <no-reply@yourdomain.com>'
EMAIL_FROM=

# --- Social auth (optional; a provider activates only when BOTH id+secret set) ---
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# --- Social button visibility (client-side; must be literal 'true' to show) ---
# NOTE: read via static access in code; dynamic process.env[key] is not inlined.
NEXT_PUBLIC_GOOGLE_ENABLED=false
NEXT_PUBLIC_GITHUB_ENABLED=false
NEXT_PUBLIC_DISCORD_ENABLED=false
