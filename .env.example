# Core authentication
# Exactly 32 random bytes in canonical base64: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
DATABASE_URL=

# Public browser configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_BETTER_AUTH_URL=http://localhost:3000

# Trusted network boundary
# Set this to a header that your edge proxy overwrites and clients cannot set.
# Examples: cf-connecting-ip for Cloudflare or x-real-ip for a controlled proxy.
AUTH_IP_ADDRESS_HEADERS=x-real-ip
# Use exact proxy addresses or narrow CIDRs when forwarded chains are required.
AUTH_TRUSTED_PROXIES=
# Generate a separate value with: openssl rand -base64 32
AUTH_FINGERPRINT_SECRET=

# Resend transactional email (verification + password reset + security notices)
# Without RESEND_API_KEY, links are logged to the server, not delivered.
RESEND_API_KEY=

# Online payments (Paystack hosted checkout). Leave empty to hide "Pay now";
# bookings then default to pay-at-salon. Use sk_test_* locally, sk_live_* in
# production. Webhook URL to register in the Paystack dashboard:
#   https://<your-domain>/api/payments/paystack/webhook
PAYSTACK_SECRET_KEY=
# Online payments: with no PAYSTACK_SECRET_KEY, development shows a fake hosted
# checkout (the pay-now journey) by default. Set PAYMENTS_MOCK=false to force
# pay-at-salon only in dev. Ignored in production (validator rejects it there).
# PAYMENTS_MOCK=false
# Sender on a Resend-verified domain, e.g. 'Alora <no-reply@alorastudios.co.za>'
EMAIL_FROM=

# Social auth. A provider activates only when both values are present.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Browser visibility must match the configured server providers.
NEXT_PUBLIC_GOOGLE_ENABLED=false
NEXT_PUBLIC_GITHUB_ENABLED=false
NEXT_PUBLIC_DISCORD_ENABLED=false

# Optional authenticated browser test account
E2E_AUTH_EMAIL=
E2E_AUTH_PASSWORD=
E2E_BASE_URL=http://127.0.0.1:3000
E2E_RATE_LIMIT_TEST=false
